  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "metadata-proxy": "node scripts/openlibrary-proxy.mjs",
    "typecheck": "tsc --noEmit",
