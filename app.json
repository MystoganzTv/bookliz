{
  "expo": {
    "name": "Bookliz",
    "slug": "booklio",
    "version": "1.3.0",
    "scheme": "bookliz",
    "orientation": "portrait",
    "icon": "./assets/brand/bookliz-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.mystodev.booklio",
      "buildNumber": "1",
      "deploymentTarget": "15.1",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Bookliz uses the camera to scan the ISBN barcode on a book.",
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Audiobook",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.audio",
              "public.mp3",
              "public.mpeg-4-audio",
              "com.apple.m4a-audio",
              "com.mystodev.booklio.m4b",
              "public.aac-audio",
              "public.aiff-audio",
              "com.microsoft.waveform-audio",
              "org.xiph.flac"
            ]
          },
          {
            "CFBundleTypeName": "Ebook",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "org.idpf.epub-container",
              "com.adobe.pdf",
              "public.plain-text",
              "com.mystodev.booklio.cbz",
              "com.mystodev.booklio.cbr"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.mystodev.booklio.m4b",
            "UTTypeDescription": "MPEG-4 audiobook",
            "UTTypeConformsTo": [
              "public.mpeg-4-audio",
              "public.audio"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "m4b"
              ],
              "public.mime-type": [
                "audio/x-m4b"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.mystodev.booklio.cbz",
            "UTTypeDescription": "Comic book archive (ZIP)",
            "UTTypeConformsTo": [
              "public.zip-archive",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "cbz"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.mystodev.booklio.cbr",
            "UTTypeDescription": "Comic book archive",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "cbr"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.mystodev.booklio"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.mystodev.booklio"
        ]
      }
    },
    "android": {
      "package": "com.mystodev.booklio",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/bookliz-icon.png",
          "color": "#14B8A6",
          "sounds": []
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.167166673441-1m9fio2dlddt0a053ip2o8b6tan85pdb"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "googleAuth": {
        "webClientId": "167166673441-tu8ias7s9t8gs09n2vnh75pbo8sgus8j.apps.googleusercontent.com",
        "iosClientId": "167166673441-1m9fio2dlddt0a053ip2o8b6tan85pdb.apps.googleusercontent.com",
        "androidClientId": "167166673441-v01ji3rds3frjipugsur98fdvlcm0li9.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "280cde91-ff6e-4e44-8ceb-53eed6ce39b0"
      }
    }
  }
}
