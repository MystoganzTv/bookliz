EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Books — dos modos, elige uno.
#
# 1) Proxy (preferido). La clave vive como secreto de Supabase y nunca entra en
#    el bundle. Deja EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY vacía y pon:
# EXPO_PUBLIC_GOOGLE_BOOKS_PROXY_URL=https://YOUR-PROJECT.supabase.co/functions/v1/google-books
#
#    Desplegar:
#      supabase secrets set GOOGLE_BOOKS_API_KEY=<la clave>
#      supabase functions deploy google-books
#
# 2) Directo (lo que había hasta ahora). La clave viaja dentro de cada build y
#    cualquiera puede sacarla de un .ipa. Sirve para desarrollo local; para la
#    build de tienda usa el proxy.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Amazon Associates (opcional). Sin esto los enlaces de "Comprar" salen sin
# parámetro de afiliado: funcionan igual, pero no generan comisión.
#
# NO pongas un tag que no sea tuyo. La política de privacidad declara la
# participación en Amazon Associates; un tag ajeno convierte esa declaración
# en falsa, y eso se castiga más caro que no cobrar.
# EXPO_PUBLIC_AMAZON_ASSOCIATES_TAG=tutag-20
